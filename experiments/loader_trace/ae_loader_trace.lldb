settings set target.inline-breakpoint-strategy always
settings set stop-disassembly-count 0

breakpoint set -n PluginDataEntryFunction2
breakpoint command add 1
frame variable
thread backtrace all -c 40
image list -o -f
continue
DONE

breakpoint set -n dlopen
breakpoint modify 2 -d

breakpoint set -n CFBundleLoadExecutableAndReturnError
breakpoint modify 3 -d

process continue
